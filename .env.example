# OIDC Configuration
# Configure your OIDC provider (Google, Okta, Auth0, Keycloak, etc.)
OIDC_PROVIDER_URL=https://accounts.google.com
OIDC_CLIENT_ID=your-client-id-here
OIDC_CLIENT_SECRET=your-client-secret-here
OIDC_REDIRECT_URL=http://localhost:8080/auth/callback
OIDC_SCOPES=openid,profile,email

# JWT Configuration
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRY=24h
# Forces the Secure flag on auth cookies. Set to true when served over HTTPS.
COOKIE_SECURE=false

# Application Configuration
VOTE_THRESHOLD=3
ADMIN_EMAILS=admin@example.com,another-admin@example.com
SYNC_BASE_URL=http://localhost:8080
SERVER_PORT=8080
# Age in hours after which a machine counts as stale on the dashboard.
STALE_MACHINE_HOURS=24

# CORS Configuration
# Comma-separated list of origins allowed to send credentialed (cookie)
# requests. Leave empty for a credential-less wildcard (dev only).
CORS_ALLOWED_ORIGINS=

# Santa Sync Configuration
# Shared secret required on the sync endpoints (preflight/eventupload/
# ruledownload/postflight). Leave empty to leave them unauthenticated
# (only safe if you authenticate at the ingress). When set, agents/ingress
# must send it as "Authorization: Bearer <key>" or "X-Santa-Key: <key>".
SANTA_SYNC_KEY=
# Desired client mode pushed to agents at preflight: MONITOR or LOCKDOWN.
SANTA_CLIENT_MODE=LOCKDOWN

# Discord Configuration
# Webhook URL for new-proposal alerts. Leave empty to disable. In production
# this is sourced from Vault and synced into the pod by VSO.
DISCORD_WEBHOOK_URL=

# Database Configuration
DATABASE_PATH=./database/krampus.db
